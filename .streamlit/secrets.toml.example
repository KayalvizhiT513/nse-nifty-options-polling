# Copy into Streamlit Community Cloud → App settings → Secrets.
# Scope the token to nse-nifty-option-nearest-expiry (the private data archive),
# with Contents: read/write. The public polling repository does not need a token.
[collector]
enabled = true
repository = "KayalvizhiT513/nse-nifty-option-nearest-expiry"
github_token = "REPLACE_WITH_YOUR_TOKEN"
checkpoint_branch = "nifty-live-data"
archive_branch = "main"
checkpoint_seconds = 900
